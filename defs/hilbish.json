		{
			"name": "multiprompt",
			"description": [
				"Changes the text prompt when Hilbish asks for more input.",
				"This will show up when text is incomplete, like a missing quote."
			],
			"signature": "multiprompt(str) -\u003e string?",
			"isInterface": false,
			"isMember": false,
			"isType": false,
			"params": [
				{
					"Name": "str",
					"Type": "string",
					"Doc": null,
					"Default": "",
					"IsOptional": true,
					"Keys": null
				}
			],
			"returns": [
				{
					"Name": "prompt",
					"Type": "string?",
					"Doc": [
						"Returns the currently set multilinePrompt if `str` is not provided."
					],
					"Default": "",
					"IsOptional": true,
					"Keys": null
				}
			],
			"tags": {
				"example": [
					{
						"id": "",
						"fields": [
							"-- imagine this is your text input:",
							"-- user ~ ∆ echo \"hey",
							"-- but there's a missing quote! hilbish will now prompt you so the terminal",
							"-- will look like:",
							"-- user ~ ∆ echo \"hey",
							"-- --\u003e ...!\"",
							"--",
							"-- so then you get:",
							"-- user ~ ∆ echo \"hey",
							"-- --\u003e ...!\"",
							"-- hey ...!",
							"hilbish.multiprompt '--\u003e'"
						],
						"startIdx": 0
					}
				]
			}
		},
