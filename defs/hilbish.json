					"Type": "number",
					"Doc": null,
					"Default": "",
					"IsOptional": false,
					"Keys": null
				},
				{
					"Name": "stdout",
					"Type": "string?",
					"Doc": [
						"Standard output of the command, if `streams` did not redirect it."
					],
					"Default": "",
					"IsOptional": true,
					"Keys": null
				},
				{
					"Name": "stderr",
					"Type": "string?",
					"Doc": [
						"Standard error output of the command, if `streams` did not redirect it."
					],
					"Default": "",
					"IsOptional": true,
					"Keys": null
				}
			],
			"tags": {
				"example": [
					{
						"id": "",
						"fields": [
							"-- This code is the same as `ls -l | wc -l`",
							"local fs = require 'fs'",
							"local pr, pw = fs.pipe()",
							"hilbish.run('ls -l', {",
							"\tstdout = pw,",
							"\tstderr = pw,",
							"})",
							"pw:close()",
							"hilbish.run('wc -l', {",
							"\tstdin = pr",
							"})"
						],
						"startIdx": 0
					}
				]
			}
